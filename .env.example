# ─────────────────────────────────────────────────────────────────────────────
# camouchat-whatsapp Docker configuration
# Copy this file to .env and fill in your values before running docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── Login ─────────────────────────────────────────────────────────────────────
# How to log in on first boot.
# 0 = QR code (requires ENABLE_VNC=1 and a browser open at localhost:8080)
# 1 = Phone pairing code (recommended — code appears in docker compose logs)
LOGIN_METHOD=1

# Required only when LOGIN_METHOD=1
WA_PHONE_NUMBER=
WA_COUNTRY=

# ── Profile ───────────────────────────────────────────────────────────────────
# Name of the CamouChat profile to create / reuse.
# Profile data (session, keys, DB) is stored under the /data volume.
PROFILE_ID=default

# ── Browser ───────────────────────────────────────────────────────────────────
# Browser headless mode.
# "virtual" = Xvfb-backed virtual display (correct for Docker, default)
# false     = open a real visible window (only works with a real display / X11 forwarding)
# true      = native headless (not recommended — more fingerprintable)
HEADLESS=virtual

# Browser locale (affects platform Web language and fingerprint)
LOCALE=en-US

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Leave empty to use the container's default network interface.
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# ── VNC / noVNC (optional) ───────────────────────────────────────────────────
# Set to 1 to start x11vnc + noVNC so you can view the virtual display in a browser.
# Useful for one-time QR login (open http://localhost:<VNC_PORT> after docker compose up).
# After logging in once, set back to 0 — the session is saved in the volume.
ENABLE_VNC=0
VNC_PORT=8080

# ── Persistence paths (do not change unless you know what you are doing) ──────
# These must match the ENV in the Dockerfile and docker-compose.yml.
# Changing them without also moving the volume data will cause a fresh login.
XDG_DATA_HOME=/data/share
XDG_CACHE_HOME=/data/cache
XDG_STATE_HOME=/data/state
